const products = [
    "Laptop",
    "Smartphone",
    "Tablet",
    "Headphones",
    "Smartwatch",
    "Bluetooth Speaker",
    "Camera",
    "Keyboard",
    "Mouse",
    "Monitor"
];

let content="";
for (let i = 0; i < products.length; i++) {
    content+= `<div class="user">
              <h2>${products[i]}</h2>
              </div>

    `
}
document.body.innerHTML = content;
